        { "name": "POST - Criar usuário", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Usuário {{runId}}\",\n  \"email\": \"postman.{{runId}}@exemplo.com\",\n  \"password\": \"senha-de-teste\",\n  \"situationId\": {{situationId}}\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "GET - Consultar usuário criado", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "PUT - Atualizar usuário", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Atualizado {{runId}}\"\n}" }, "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "GET - Confirmar usuário atualizado", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "POST - Rejeitar e-mail duplicado", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Duplicado\",\n  \"email\": \"postman.{{runId}}@exemplo.com\",\n  \"password\": \"senha-de-teste\"\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "POST - Rejeitar e-mail inválido", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Inválido\",\n  \"email\": \"email-invalido\",\n  \"password\": \"senha-de-teste\"\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "DELETE - Remover usuário criado", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "GET - Confirmar exclusão do usuário", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" } }
      ]
    },
    {
      "name": "Product Categories",
      "item": [
        { "name": "GET - Listar categorias", "request": { "method": "GET", "url": "{{baseUrl}}/product-categories" } },
        { "name": "POST - Criar categoria", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Categoria {{runId}}\"\n}" }, "url": "{{baseUrl}}/product-categories" } },
        { "name": "GET - Consultar categoria criada", "request": { "method": "GET", "url": "{{baseUrl}}/product-categories/{{categoryId}}" } },
        { "name": "PUT - Atualizar categoria", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Atualizado {{runId}}\"\n}" }, "url": "{{baseUrl}}/product-categories/{{categoryId}}" } },
        { "name": "GET - Confirmar categoria atualizada", "request": { "method": "GET", "url": "{{baseUrl}}/product-categories/{{categoryId}}" } }
