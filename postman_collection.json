	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"const method = pm.request.method;",
					"const hasId = /\\/\\d+$/.test(pm.request.url.getPath());",
					"const expectedStatus = {",
					"    GET: hasId ? [200, 404] : [200],",
					"    POST: [201],",
					"    PUT: [200, 404],",
					"    DELETE: [200, 404]",
					"};",
					"",
					"pm.test('Status HTTP esperado para ' + method, function () {",
					"    pm.expect(expectedStatus[method]).to.include(pm.response.code);",
					"});",
					"",
					"pm.test('Resposta em JSON válido', function () {",
					"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"    pm.expect(function () { pm.response.json(); }).not.to.throw();",
					"});"
				]
			}
		}
	],
