{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Projeto Node API - Testes CRUD",
    "description": "Fluxo de testes CRUD do diagrama. A coleção cria registros próprios, valida as respostas e remove os dados criados ao final.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "runId", "value": "", "type": "string" },
    { "key": "situationId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "productSituationId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'POST - Cadastrar situação') {",
          "    pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const resource = pm.request.url.getPath().split('/').filter(Boolean)[0];",
          "const method = pm.request.method;",
          "const name = pm.info.requestName;",
          "const idVariables = { situations: 'situationId', users: 'userId', 'product-categories': 'categoryId', 'product-situations': 'productSituationId', products: 'productId' };",
          "const responseKeys = { situations: 'situation', users: 'user', 'product-categories': 'productCategory', 'product-situations': 'productSituation', products: 'product' };",
          "const nameFields = { situations: 'nameSituation', users: 'name', 'product-categories': 'name', 'product-situations': 'name', products: 'name' };",
          "let expectedStatus = method === 'POST' ? 201 : method === 'PUT' || method === 'DELETE' ? 200 : 200;",
          "if (name.includes('e-mail inválido')) expectedStatus = 400;",
          "if (name.includes('e-mail duplicado')) expectedStatus = 409;",
          "if (name.includes('Confirmar exclusão')) expectedStatus = 404;",
          "pm.test('Status HTTP conforme o cenário', function () { pm.response.to.have.status(expectedStatus); });",
          "pm.test('Resposta JSON válida', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(function () { pm.response.json(); }).not.to.throw(); });",
          "if (expectedStatus < 400) {",
          "    const data = pm.response.json();",
          "    if (method === 'GET' && pm.request.url.getPath().split('/').filter(Boolean).length === 1) {",
          "        pm.test('Listagem retorna uma coleção', function () { pm.expect(data).to.be.an('array'); });",
          "    } else if (method === 'POST') {",
          "        const created = data[responseKeys[resource]];",
          "        pm.test('Cadastro retorna o registro e seu ID', function () { pm.expect(created).to.be.an('object'); pm.expect(created.id).to.be.a('number'); });",
          "        if (created && created.id) pm.collectionVariables.set(idVariables[resource], String(created.id));",
          "        if (resource === 'users') pm.test('Senha não é exposta na resposta', function () { pm.expect(created).not.to.have.property('password'); });",
          "    } else if (method === 'GET') {",
          "        pm.test('Consulta retorna o registro solicitado', function () { pm.expect(data.id).to.eql(Number(pm.collectionVariables.get(idVariables[resource]))); });",
          "        if (name.includes('Confirmar') && !name.includes('exclusão')) pm.test('Alteração foi persistida', function () { pm.expect(data[nameFields[resource]]).to.eql('Atualizado ' + pm.collectionVariables.get('runId')); });",
          "        if (resource === 'users') pm.test('Usuário inclui a situação relacionada sem expor senha', function () { pm.expect(data).to.have.property('situation'); pm.expect(data).not.to.have.property('password'); });",
          "        if (resource === 'products') pm.test('Produto inclui categoria e situação relacionadas', function () { pm.expect(data.productCategory.id).to.eql(Number(pm.collectionVariables.get('categoryId'))); pm.expect(data.productSituation.id).to.eql(Number(pm.collectionVariables.get('productSituationId'))); });",
          "    } else if (method === 'PUT') {",
          "        const updated = data[responseKeys[resource]];",
          "        pm.test('Atualização retorna o registro alterado', function () { pm.expect(updated.id).to.eql(Number(pm.collectionVariables.get(idVariables[resource]))); pm.expect(updated[nameFields[resource]]).to.eql('Atualizado ' + pm.collectionVariables.get('runId')); });",
          "    } else if (method === 'DELETE') {",
          "        pm.test('Exclusão confirma a operação', function () { pm.expect(data.mensagem).to.be.a('string').and.not.empty; });",
          "    }",
          "} else if (expectedStatus === 404) {",
          "    pm.test('Registro excluído não é mais encontrado', function () { pm.expect(pm.response.json().mensagem).to.be.a('string'); });",
          "} else if (expectedStatus === 400 || expectedStatus === 409) {",
          "    pm.test('Erro de validação informa o motivo', function () { pm.expect(pm.response.json().mensagem).to.be.a('string').and.not.empty; });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Situations",
      "item": [
        { "name": "GET - Listar situações", "request": { "method": "GET", "url": "{{baseUrl}}/situations" } },
        { "name": "POST - Cadastrar situação", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nameSituation\": \"Ativo {{runId}}\"\n}" }, "url": "{{baseUrl}}/situations" } },
        { "name": "GET - Consultar situação criada", "request": { "method": "GET", "url": "{{baseUrl}}/situations/{{situationId}}" } },
        { "name": "PUT - Atualizar situação", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nameSituation\": \"Atualizado {{runId}}\"\n}" }, "url": "{{baseUrl}}/situations/{{situationId}}" } },
        { "name": "GET - Confirmar situação atualizada", "request": { "method": "GET", "url": "{{baseUrl}}/situations/{{situationId}}" } }
      ]
    },
    {
      "name": "Users",
      "item": [
